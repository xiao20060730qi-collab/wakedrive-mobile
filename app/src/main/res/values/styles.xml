<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.WakeDrive.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.WakeDrive.Button.Primary">
        <item name="backgroundTint">@color/cyan</item>
        <item name="android:textColor">#04131B</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.WakeDrive.Button.Secondary">
        <item name="backgroundTint">#123C55</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">#2F6E86</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.WakeDrive.Button.Danger">
        <item name="backgroundTint">#3A2330</item>
        <item name="android:textColor">#FFCAD2</item>
        <item name="strokeColor">#8C4D5D</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.WakeDrive.Tab" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
